---
// Корень сайта: выбор языка по браузеру (русский — /ru/, иначе — /en/).
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Personal Data Cleaner (PDC)</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <script is:inline define:vars={{ base }}>
      const lang = (navigator.languages?.[0] || navigator.language || 'en').toLowerCase();
      location.replace(base + (lang.startsWith('ru') ? 'ru/' : 'en/'));
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${base}ru/`} /></noscript>
  </head>
  <body>
    <p><a href={`${base}ru/`}>Русский</a> · <a href={`${base}en/`}>English</a></p>
  </body>
</html>
