---
import SocialMeta from '../components/SocialMeta.astro';
import {languages, languageNames} from '../i18n/languages';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Personal Data Cleaner (PDC)</title>
    <link rel="canonical" href={new URL(base, Astro.site)} />
    {languages.map(lang => <link rel="alternate" hreflang={lang} href={new URL(`${base}${lang}/`, Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(base, Astro.site)} />
    <SocialMeta title="Personal Data Cleaner (PDC)" description="Desktop, Web and Server for document privacy." url={new URL(base, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <script>
      import {preferredLanguage} from '../i18n/languages';
      let saved: string | null = null;
      try { saved = localStorage.getItem('pdc-language'); } catch {}
      const lang = preferredLanguage(saved, navigator.languages?.length ? navigator.languages : [navigator.language]);
      location.replace(`${document.documentElement.dataset.base}${lang}/${location.search}${location.hash}`);
    </script>
  </head>
  <body><nav aria-label="Language">{languages.map(lang => <a href={`${base}${lang}/`} lang={lang}>{languageNames[lang]} </a>)}</nav></body>
</html>
