---
import '../styles/global.css';
import type { Content, Lang } from '../i18n/content';

interface Props {
  lang: Lang;
  t: Content;
}

const { lang, t } = Astro.props;
const base = import.meta.env.BASE_URL;
const other = t.langSwitch.target;
const canonical = new URL(`${base}${lang}/`, Astro.site);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={new URL(`${base}ru/`, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(`${base}en/`, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-row">
        <a class="brand" href={`${base}${lang}/`}>
          <img src={`${base}favicon.svg`} alt="" width="28" height="28" />
          <span>PDC</span>
        </a>
        <nav class="nav" aria-label="Main">
          <a href="#features">{t.nav.features}</a>
          <a href="#how">{t.nav.how}</a>
          <a href="#example">{t.nav.example}</a>
          <a href="#requirements">{t.nav.requirements}</a>
          <a href="#faq">{t.nav.faq}</a>
          <a href="#contact">{t.nav.contact}</a>
        </nav>
        <a class="lang-switch" href={`${base}${other}/`} hreflang={other} lang={other}>{t.langSwitch.label}</a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} Personal Data Cleaner (PDC). {t.footer}</p>
      </div>
    </footer>
  </body>
</html>
