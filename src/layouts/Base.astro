---
import { ui } from '../i18n/ui';
import '../styles/global.css';
import PrivacyBackdrop from '../components/PrivacyBackdrop.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import SocialMeta from '../components/SocialMeta.astro';
import LanguageSelect from '../components/LanguageSelect.astro';
import {languages} from '../i18n/languages';
import type { Content, Lang } from '../i18n/content';

interface Props {
  lang: Lang;
  t: Content;
  section?: string;
}

const { lang, t, section = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(`${base}${lang}/${section}`, Astro.site);
const home = `${base}${lang}/`;
---

<!doctype html>
<html lang={t.htmlLang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply the saved theme before painting; a new visitor starts in dark mode.
      try {
        const savedTheme = localStorage.getItem('pdc-theme');
        if (savedTheme === 'light') document.documentElement.dataset.theme = 'light';
      } catch { /* Dark remains the default when storage is unavailable. */ }
    </script>
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    {languages.map(code => <link rel="alternate" hreflang={code} href={new URL(`${base}${code}/${section}`, Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(section ? `${base}en/${section}` : base, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <SocialMeta title={t.meta.title} description={t.meta.description} url={canonical} />
  </head>
  <body>
    <PrivacyBackdrop lang={lang} />
    <header class="site-header">
      <div class="container header-row">
        <a class="brand" href={`${base}${lang}/`}>
          <img src={`${base}favicon.svg`} alt="" width="28" height="28" />
          <span>PDC</span>
        </a>
        <details class="mobile-nav">
          <summary>{ui(lang, 'Main navigation')}</summary>
          <nav aria-label={ui(lang, 'Main navigation')}>
            <a href={`${home}#features`}>{t.nav.features}</a>
            <a href={`${home}#how`}>{t.nav.how}</a>
            <a href={`${home}#example`}>{t.nav.example}</a>
            <a href={`${home}#pdc-web`}>PDC.Web</a>
            <a href={`${home}#requirements`}>{t.nav.requirements}</a>
            <a href={`${home}#faq`}>{t.nav.faq}</a>
            <a href={`${home}#contact`}>{t.nav.contact}</a>
          </nav>
        </details>
        <nav class="nav" aria-label={ui(lang, "Main navigation")}>
          <a href={`${home}#features`}>{t.nav.features}</a>
          <a href={`${home}#how`}>{t.nav.how}</a>
          <a href={`${home}#example`}>{t.nav.example}</a>
          <a href={`${home}#requirements`}>{t.nav.requirements}</a>
          <a href={`${home}#faq`}>{t.nav.faq}</a>
          <a href={`${home}#contact`}>{t.nav.contact}</a>
        </nav>
        <div class="header-tools">
          <a class="release-link" href={`${home}changelog/`} aria-current={section === 'changelog/' ? 'page' : undefined}>{ui(lang, "Updates")}</a>
          <details class="investor-menu">
            <summary>{ui(lang, "For investors")}</summary>
            <div class="investor-downloads">
              {(lang === 'ru' ? ['RU', 'EN'] : ['EN', 'RU']).map(pdfLang => <a href={`${base}downloads/PDC_Startup_Deck_${pdfLang}_V3.pdf`} download={`PDC_Startup_Deck_${pdfLang}_V3.pdf`} hreflang={pdfLang.toLowerCase()}>{ui(lang, "Download presentation")} · {pdfLang} (PDF)</a>)}
            </div>
          </details>
          <ThemeToggle lang={lang} />
          <LanguageSelect lang={lang} section={section} />
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} Personal Data Cleaner (PDC). {t.footer}</p>
      </div>
    </footer>
  </body>
</html>

<script>
  const investors = document.querySelector<HTMLDetailsElement>('.investor-menu');
  const navigation = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  navigation?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { navigation.open = false; }));
  const wide = matchMedia('(min-width: 761px)');
  wide.addEventListener('change', () => { if (wide.matches && navigation) navigation.open = false; });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && navigation?.open) { navigation.open = false; navigation.querySelector('summary')?.focus(); }
    if (event.key === 'Escape' && investors?.open) { investors.open = false; investors.querySelector('summary')?.focus(); }
  });
  document.addEventListener('click', event => {
    if (investors?.open && !investors.contains(event.target as Node)) investors.open = false;
    if (navigation?.open && !navigation.contains(event.target as Node)) navigation.open = false;
  });
</script>
