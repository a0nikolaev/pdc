---
import type { Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const pairs = [
  ['Алексей Примеров', '[PERSON]'],
  ['name@example.com', '[EMAIL]'],
  ['+0 (000) 000-00-00', '[PHONE]'],
  ['0000 0000 0000 0000', '[BANKCARD]'],
  ['Sample Name', '[PERSON]'],
  ['user@example.org', '[EMAIL]'],
];
---
<div class="privacy-backdrop" aria-hidden="true">
  <div class="privacy-grid"></div>
  <div class="privacy-glow privacy-glow-one"></div>
  <div class="privacy-glow privacy-glow-two"></div>
  {pairs.map(([source, replacement], i) => (
    <div class="privacy-stream" style={`--stream:${i}; --stream-y:${12 + i * 15}%; --delay:${-i * 3.4}s`}>
      <span class="privacy-source">{source}</span>
      <svg viewBox="0 0 48 24" width="48" height="24"><path d="M2 12h40m-8-7 8 7-8 7" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
      <span class="privacy-tag">{replacement}</span>
    </div>
  ))}
  <svg class="privacy-orbit" viewBox="0 0 700 700" fill="none">
    <circle cx="350" cy="350" r="285" stroke="currentColor" stroke-dasharray="3 12" />
    <circle cx="350" cy="350" r="220" stroke="currentColor" stroke-opacity=".5" />
    <path d="M65 350h570M350 65v570M149 149l402 402M149 551l402-402" stroke="currentColor" stroke-opacity=".2" />
    <g fill="currentColor"><circle cx="350" cy="65" r="7" /><circle cx="635" cy="350" r="5" /><circle cx="350" cy="635" r="7" /><circle cx="65" cy="350" r="5" /><circle cx="505" cy="195" r="5" /><circle cx="195" cy="505" r="5" /></g>
  </svg>
  <svg class="privacy-shield" viewBox="0 0 160 190" fill="none">
    <path d="M80 10 145 35v53c0 43-30 75-65 92-35-17-65-49-65-92V35Z" stroke="currentColor" stroke-width="1" />
    <path d="m53 95 19 19 37-42" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</div>
<button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false" aria-label={lang === 'ru' ? 'Приостановить анимацию фона' : 'Pause background animation'} data-pause-label={lang === 'ru' ? 'Приостановить анимацию фона' : 'Pause background animation'} data-play-label={lang === 'ru' ? 'Включить анимацию фона' : 'Play background animation'}>
  <span data-motion-icon aria-hidden="true">Ⅱ</span><span>{lang === 'ru' ? 'Анимация фона' : 'Background animation'}</span>
</button>
<script>
  const button = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
  button?.addEventListener('click', () => {
    const paused = button.getAttribute('aria-pressed') !== 'true';
    button.setAttribute('aria-pressed', String(paused));
    button.setAttribute('aria-label', (paused ? button.dataset.playLabel : button.dataset.pauseLabel)!);
    document.documentElement.classList.toggle('motion-paused', paused);
    button.querySelector('[data-motion-icon]')!.textContent = paused ? '▷' : 'Ⅱ';
  });
</script>
