---
import Base from '../layouts/Base.astro';
import { content, type Lang } from '../i18n/content';
import releases from '../data/releases.json';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ru = lang === 'ru';
const entries = releases[lang];
const latest = { desktop: entries.find(r => r.component === 'desktop')!, server: entries.find(r => r.component === 'server')! };
const title = ru ? 'История изменений' : 'Release notes';
const description = ru ? 'Что нового в PDC.Desktop и PDC.Server: основные изменения каждого обновления.' : 'What’s new in PDC.Desktop and PDC.Server: the highlights of each update.';
const t = { ...content[lang], meta: { title: `${title} — Personal Data Cleaner`, description } };
const base = import.meta.env.BASE_URL;
---
<Base lang={lang} t={t} section="changelog/">
  <section class="release-hero container">
    <a class="release-back" href={`${base}${lang}/`}>← {ru ? 'О продукте' : 'About the product'}</a>
    <p class="eyebrow">PDC / {ru ? 'Развитие продукта' : 'Product evolution'}</p>
    <h1>{ru ? 'С каждым обновлением' : 'A little better'}<br/><span>{ru ? 'лучше.' : 'with every update.'}</span></h1>
    <p class="release-lead">{description} {ru ? 'Новые возможности, улучшения и исправления — в одном месте.' : 'New features, improvements and fixes, all in one place.'}</p>
    <div class="release-current">
      {Object.entries(latest).map(([key, release]) => <a href={`#${key}-${release.version}`} class={`current-version ${key}`}>
        <span class="release-dot" aria-hidden="true"></span><span>PDC.{key === 'desktop' ? 'Desktop' : 'Server'}</span><strong>v{release.version}</strong><span aria-hidden="true">↘</span>
      </a>)}
    </div>
  </section>
  <section class="container release-layout" aria-label={title}>
    <aside class="release-aside">
      <h2>{title}</h2>
      <p>{ru ? 'Клиент и сервер развиваются независимо. Выберите интересующий компонент.' : 'Client and server evolve independently. Choose the component you’re interested in.'}</p>
      <div class="release-filters" role="group" aria-label={ru ? 'Фильтр по компоненту' : 'Filter by component'} hidden>
        <button type="button" data-release-filter="all" aria-pressed="true">{ru ? 'Все обновления' : 'All updates'} <span>{entries.length}</span></button>
        <button type="button" data-release-filter="desktop" aria-pressed="false">Desktop <span>{entries.filter(r => r.component === 'desktop').length}</span></button>
        <button type="button" data-release-filter="server" aria-pressed="false">{ru ? 'Сервер' : 'Server'} <span>{entries.filter(r => r.component === 'server').length}</span></button>
      </div>
      <p class="release-note">{ru ? 'Здесь — основные изменения выпущенных версий. Запланированные возможности появятся после реализации.' : 'These are highlights of released versions. Planned features will appear once implemented.'}</p>
      <p class="release-count" aria-live="polite" data-release-count data-label={ru ? 'Показано обновлений' : 'Updates shown'}>{ru ? 'Показано обновлений' : 'Updates shown'}: {entries.length}</p>
    </aside>
    <div class="release-timeline">
      {entries.map(release => <article class={`release-card ${release.component}`} id={`${release.component}-${release.version}`} data-release-component={release.component}>
        <div class="release-meta"><span class="component-badge">PDC.{release.component === 'desktop' ? 'Desktop' : 'Server'}</span><time datetime={release.date}>{new Intl.DateTimeFormat(ru ? 'ru-RU' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${release.date}T00:00:00Z`))}</time></div>
        <div class="release-version"><h2><a href={`#${release.component}-${release.version}`}>v{release.version}</a></h2>{latest[release.component as 'desktop' | 'server'].version === release.version && <span class="latest-badge">{ru ? 'Актуальная' : 'Latest'}</span>}</div>
        <h3>{release.highlights[0]}</h3>
        {release.highlights.length > 1 && <ul>{release.highlights.slice(1).map(item => <li>{item}</li>)}</ul>}
      </article>)}
    </div>
  </section>
</Base>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-release-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-release-component]');
  const count = document.querySelector<HTMLElement>('[data-release-count]');
  document.querySelector<HTMLElement>('.release-filters')?.removeAttribute('hidden');
  function filter(value: string) {
    buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.releaseFilter === value)));
    let visible = 0;
    cards.forEach(card => { card.hidden = value !== 'all' && card.dataset.releaseComponent !== value; if (!card.hidden) visible++; });
    if (count) count.textContent = `${count.dataset.label}: ${visible}`;
  }
  buttons.forEach(button => button.addEventListener('click', () => filter(button.dataset.releaseFilter!)));
  // Deep links always reveal their release, even after filtering.
  window.addEventListener('hashchange', () => { const target = document.getElementById(location.hash.slice(1)); if (target?.hidden) { filter('all'); target.scrollIntoView(); } });
</script>
<style>
  .release-hero { padding-block: 48px 60px; }
  .release-back { display:inline-block; color:var(--muted); text-decoration:none; margin-bottom:44px; }
  .release-hero h1 { font-size:clamp(2.7rem,6vw,5rem); line-height:1.05; letter-spacing:-.055em; max-width:950px; margin:18px 0 26px; }
  .release-hero h1 span { color:var(--accent); }
  .release-lead { max-width:650px; font-size:1.12rem; color:var(--muted); line-height:1.75; }
  .release-current { display:flex; gap:12px; flex-wrap:wrap; margin-top:32px; }
  .current-version { display:flex; align-items:center; gap:12px; border:1px solid var(--border); border-radius:12px; background:var(--card); padding:16px 20px; text-decoration:none; color:var(--text); }
  .current-version strong { color:var(--accent); font-variant-numeric:tabular-nums; }
  .release-dot { width:7px; height:7px; border-radius:50%; background:var(--accent); box-shadow:0 0 0 4px var(--accent-soft); }
  .server .release-dot { background:var(--benefit-color); }
  .release-layout { display:grid; grid-template-columns:245px minmax(0,1fr); gap:70px; padding-bottom:100px; align-items:start; }
  .release-aside { position:sticky; top:110px; }
  .release-aside h2 { font-size:1.2rem; margin:0 0 14px; }
  .release-aside p { font-size:.9rem; line-height:1.7; color:var(--muted); }
  .release-filters { display:grid; gap:6px; margin-block:24px; }
  .release-filters[hidden] { display:none; }
  .release-filters button { display:flex; justify-content:space-between; gap:16px; font:inherit; font-size:.9rem; cursor:pointer; padding:13px 14px; border:1px solid transparent; border-radius:8px; color:var(--muted); background:transparent; text-align:left; }
  .release-filters button[aria-pressed='true'] { color:var(--accent); border-color:var(--border); background:var(--accent-soft); }
  .release-filters button:hover { color:var(--text); background:var(--card); }
  .release-filters span { font-size:.8rem; opacity:.8; }
  .release-note { border-top:1px solid var(--border); padding-top:20px; }
  .release-timeline { border-left:1px solid var(--border); padding-left:32px; }
  .release-card { position:relative; border:1px solid var(--border); background:var(--card); border-radius:18px; padding:30px; margin-bottom:24px; scroll-margin-top:110px; box-shadow:var(--shadow); }
  .release-card[hidden] { display:none; }
  .release-card::before { content:''; position:absolute; width:9px; height:9px; background:var(--accent); border:5px solid var(--bg); border-radius:50%; left:-42px; top:36px; }
  .release-card.server::before { background:var(--benefit-color); }
  .release-meta { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; color:var(--muted); font-size:.78rem; }
  .component-badge { color:var(--accent); letter-spacing:.03em; }
  .server .component-badge { color:var(--benefit-color); }
  .release-version { display:flex; align-items:center; gap:14px; margin-block:18px; flex-wrap:wrap; }
  .release-version h2 { font-size:2rem; letter-spacing:-.04em; margin:0; }
  .release-version a { color:var(--text); text-decoration:none; }
  .latest-badge { border-radius:20px; padding:5px 10px; color:var(--benefit-color); background:var(--benefit-background); font-size:.7rem; }
  .release-card h3 { font-size:1.08rem; line-height:1.65; margin:0; font-weight:550; }
  .release-card ul { padding-left:20px; color:var(--muted); line-height:1.8; font-size:.95rem; margin:16px 0 0; }
  .release-card li+li { margin-top:8px; }
  :global(.release-link) { font-size:.85rem; color:var(--muted); text-decoration:none; white-space:nowrap; }
  :global(.release-link[aria-current='page']) { color:var(--accent); }
  @media(max-width:1000px) { .release-layout { gap:30px; grid-template-columns:210px minmax(0,1fr); } }
  @media(max-width:760px) { .release-layout { display:block; } .release-aside { position:static; } .release-filters { display:flex; flex-wrap:wrap; } .release-note { display:none; } .release-timeline { margin-top:30px; padding-left:20px; } .release-card { padding:22px; } .release-card::before { left:-30px; } .release-hero { padding-top:30px; } .release-back { margin-bottom:26px; } .current-version { padding:14px; font-size:.85rem; gap:10px; } }
  @media(prefers-reduced-motion:reduce) { :global(html) { scroll-behavior:auto; } }
</style>
